{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dayu-sec/wist-software-kb/schemas/advisory.schema.json",
  "title": "software advisory (curated, OSV-compatible)",
  "type": "object",
  "required": ["osv_id", "product_id", "ecosystem", "affected", "source", "references"],
  "additionalProperties": false,
  "properties": {
    "osv_id": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "default": [] },
    "product_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{32}$",
      "description": "必须指向 products/ 里存在的产品"
    },
    "ecosystem": {
      "type": "string",
      "description": "OSV ecosystem 词表：Debian:12 / Alpine:v3.20 / npm / PyPI / Go / crates.io …"
    },
    "source": { "type": "string", "enum": ["curated", "osv", "nvd", "distro", "vendor"] },
    "affected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "introduced": { "type": "string" },
          "fixed": { "type": "string" },
          "last_affected": { "type": "string" }
        },
        "anyOf": [
          { "required": ["introduced"] },
          { "required": ["fixed"] },
          { "required": ["last_affected"] }
        ]
      }
    },
    "severity": { "type": "array", "items": { "type": "string" }, "default": [] },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "只存链接，不转存漏洞描述全文"
    },
    "exploited_known": { "type": ["boolean", "null"] },
    "revoked": { "type": ["string", "null"], "description": "OSV 的撤回时间；撤回不物理删除" },
    "published_at": { "type": ["string", "null"] },
    "modified_at": { "type": ["string", "null"] },
    "note": { "type": ["string", "null"], "description": "curated 修订理由" }
  }
}
